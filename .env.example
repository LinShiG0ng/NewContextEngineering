# 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# ==================== LLM API配置 ====================

# API提供商: openai / anthropic / ollama / custom
LLM_PROVIDER=openai

# API密钥（OpenAI或Anthropic）
LLM_API_KEY=your-api-key-here

# API Base URL（可选，用于自定义API或代理）
# LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-3.5-turbo

# 最大Token数
LLM_MAX_TOKENS=8000

# 温度参数 (0.0-2.0)
LLM_TEMPERATURE=0.7


# ==================== OpenAI配置示例 ====================
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-3.5-turbo
# LLM_MAX_TOKENS=8000


# ==================== Anthropic配置示例 ====================
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MAX_TOKENS=8000


# ==================== Ollama配置示例 ====================
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_MAX_TOKENS=8000
# 注意：Ollama不需要API Key


# ==================== 自定义API配置示例 ====================
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-api-endpoint.com/v1
# LLM_API_KEY=your-custom-api-key
# LLM_MODEL=your-model-name
# LLM_MAX_TOKENS=8000


# ==================== Qwen/通义千问配置示例 ====================
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus-latest
# LLM_MAX_TOKENS=8000
# 注意：Qwen使用DASHSCOPE_API_KEY


# ==================== LLM压缩API密钥配置 ====================
# LLM压缩功能需要单独的API密钥配置
# 如果不启用LLM压缩，无需配置此部分

# OpenAI API密钥（用于LLM压缩）
OPENAI_API_KEY=your-openai-api-key

# Anthropic API密钥（用于LLM压缩）
ANTHROPIC_API_KEY=your-anthropic-api-key

# Qwen/通义千问 API密钥（用于LLM压缩，推荐国内用户）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 注意：
# 1. LLM压缩默认关闭，需在config.py中设置 USE_LLM_COMPRESSION = True
# 2. 根据你选择的提供商，只需要配置对应的API密钥
# 3. 推荐使用：
#    - gpt-4o-mini (OpenAI，性价比最高)
#    - claude-3-5-haiku (Anthropic，性价比高)
#    - qwen-plus-latest (Qwen，性价比极高，推荐国内用户)
