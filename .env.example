# 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# ==================== LLM API配置 ====================

# API提供商: openai / anthropic / ollama / custom
LLM_PROVIDER=custom

# API密钥（OpenAI或Anthropic）
LLM_API_KEY=sk-0af3c96a7bdf4c0185129ab9a5b3328c


# API Base URL（可选，用于自定义API或代理）
# LLM_BASE_URL=https://api.openai.com/v1

# 模型名称
LLM_MODEL=gpt-3.5-turbo

# 最大Token数
LLM_MAX_TOKENS=8000

# 温度参数 (0.0-2.0)
LLM_TEMPERATURE=0.7


# ==================== OpenAI配置示例 ====================
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-3.5-turbo
# LLM_MAX_TOKENS=8000


# ==================== Anthropic配置示例 ====================
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MAX_TOKENS=8000


# ==================== Ollama配置示例 ====================
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_MAX_TOKENS=8000
# 注意：Ollama不需要API Key


# ==================== 自定义API配置示例 ====================
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-api-endpoint.com/v1
# LLM_API_KEY=your-custom-api-key
# LLM_MODEL=your-model-name
# LLM_MAX_TOKENS=8000
